generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?

  username    String? @unique
  bio         String?
  interests   String  @default("")
  avatarHue   Int     @default(140)
  preferences String  @default("{}")

  role             String    @default("USER")
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts           Account[]
  sessions           Session[]
  interactions       Interaction[]
  demoProgress       DemoProgress[]
  networkExperiments NetworkExperiment[]
  robotConfigs       RobotConfig[]
  timelineBookmarks  TimelineBookmark[]

  @@index([createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Interaction {
  id        String   @id @default(cuid())
  userId    String
  type      String
  demo      String?
  label     String
  metadata  String   @default("{}")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([type])
}

model DemoProgress {
  id             String   @id @default(cuid())
  userId         String
  demo           String
  visits         Int      @default(1)
  completedSteps String   @default("[]")
  lastVisitedAt  DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, demo])
}

model NetworkExperiment {
  id           String   @id @default(cuid())
  userId       String
  name         String
  dataset      String
  hiddenLayers String
  activation   String   @default("tanh")
  learningRate Float
  epochs       Int
  seed         Int
  finalLoss    Float?
  accuracy     Float?
  lossHistory  String   @default("[]")
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model TimelineBookmark {
  id        String   @id @default(cuid())
  userId    String
  eventSlug String
  note      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventSlug])
  @@index([userId])
}

model RobotConfig {
  id           String   @id @default(cuid())
  userId       String
  name         String
  chassis      String
  locomotion   String
  powerCore    String
  aiCore       String
  sensors      String   @default("[]")
  modules      String   @default("[]")
  stats        String   @default("{}")
  terrainScore Float?
  isFavorite   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}
model SurveyResponse {
  id        String   @id @default(cuid())
  visitorId String
  userId    String?
  question  Int
  choice    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([visitorId, question])
  @@index([question])
}

model SavedCreature {
  id        String   @id @default(cuid())
  userId    String
  name      String
  data      String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  role      String
  text      String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}